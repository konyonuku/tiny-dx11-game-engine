# Wedge (ramp) for orientation checks. Authored in OBJ convention:
# right-handed, +Y up, CCW front faces, UV origin bottom-left, 1 unit = 1 m.
# The tall wall is at OBJ z = -0.5, which becomes engine +Z (away from the camera).
# The slope rises from the camera side toward the wall and faces the camera.

v -0.5 -0.5  0.5
v  0.5 -0.5  0.5
v  0.5 -0.5 -0.5
v -0.5 -0.5 -0.5
v  0.5  0.5 -0.5
v -0.5  0.5 -0.5

vt 0 0
vt 1 0
vt 1 1
vt 0 1

vn  0 -1  0
vn  0  0 -1
vn  0  0.7071068 0.7071068
vn  1  0  0
vn -1  0  0

# bottom
f 1/1/1 4/4/1 3/3/1 2/2/1
# tall wall
f 4/2/2 6/3/2 5/4/2 3/1/2
# slope
f 1/1/3 2/2/3 5/3/3 6/4/3
# right side
f 2/1/4 3/2/4 5/3/4
# left side
f 1/2/5 6/4/5 4/1/5
